ARG ALPINE_IMAGE=alpine:3.13
ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/404404/HermesStatus
FROM ${ALPINE_IMAGE}

ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/404404/HermesStatus

LABEL org.opencontainers.image.title="HermesStatus Client" \
    org.opencontainers.image.description="HermesStatus host and Hermes profile collector" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.source="${SOURCE_URL}" \
    org.opencontainers.image.licenses="MIT"

WORKDIR /app

# smartmontools reads the configured host device; util-linux provides lscpu.
RUN apk add --no-cache python3 py3-psutil py3-yaml iproute2 procps smartmontools util-linux

COPY clients/client-linux.py /app/client-linux.py
COPY clients/client-psutil.py /app/client-psutil.py
COPY clients/host_collector.py /app/host_collector.py
COPY scripts/export-hermes-status.py /app/export-hermes-status.py
COPY scripts/hermes_config_summary.py /app/hermes_config_summary.py
COPY hermes-exporter.json /app/hermes-exporter.json
COPY clients/entrypoint.sh /app/entrypoint.sh

# Default client and defaults (can be overridden by docker env)
ENV SERVER=127.0.0.1 \
    SERVERSTATUS_USER=s01 \
    USER=s01 \
    PORT=35601 \
    INTERVAL=1 \
    PROBEPORT=80 \
    PROBE_PROTOCOL_PREFER=ipv4 \
    PING_PACKET_HISTORY_LEN=100 \
    CU=cu.tz.cloudcpp.com \
    CT=ct.tz.cloudcpp.com \
    CM=cm.tz.cloudcpp.com \
    CLIENT=psutil \
    HOST_OS_RELEASE_FILE=/host/etc/os-release \
    HWMON_ROOT=/sys/class/hwmon \
    SMART_DEVICE=auto \
    DOCKER_SOCKET=/var/run/docker.sock \
    HARDWARE_INTERVAL=600 \
    DOCKER_INTERVAL=60 \
    DOCKER_CONTAINER_LIMIT=0 \
    CLIENT_STATUS_DIR=/var/lib/serverstatus-client \
    HERMES_EXPORT_CONFIG=/app/hermes-exporter.json \
    HERMES_ROOT=/home/hermes \
    HERMES_STATUS_DIR=/var/lib/serverstatus-client/hermes \
    HERMES_STATUS_FILE=/var/lib/serverstatus-client/hermes/hermes.json \
    HERMES_EXPORT_ENABLED=true \
    HERMES_EXPORT_INTERVAL=600 \
    HERMES_SNAPSHOT_INTERVAL=10

RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
CMD []
