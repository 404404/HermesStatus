ARG ALPINE_IMAGE=alpine:3.13
ARG VERSION=2.5
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/404404/HermesStatus
FROM ${ALPINE_IMAGE}

ARG VERSION=2.5
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/404404/HermesStatus

LABEL org.opencontainers.image.title="HermesStatus Client" \
    org.opencontainers.image.description="HermesStatus host and Hermes profile collector" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.source="${SOURCE_URL}" \
    org.opencontainers.image.licenses="MIT" \
    io.hermesstatus.component="client"

WORKDIR /app

# smartmontools reads the configured host device; util-linux provides lscpu.
RUN apk add --no-cache python3 py3-psutil py3-yaml iproute2 procps smartmontools util-linux openssh-client \
    && mkdir -p /host/etc.defaults \
    && touch /host/etc.defaults/VERSION

COPY clients/client-linux.py /app/client-linux.py
COPY clients/client-psutil.py /app/client-psutil.py
COPY clients/multi_device_contracts.py /app/multi_device_contracts.py
COPY clients/client_config_v1.py /app/client_config_v1.py
COPY clients/secure_file.py /app/secure_file.py
COPY clients/device_client_config.py /app/device_client_config.py
COPY clients/device_client_transport.py /app/device_client_transport.py
COPY clients/host_collector.py /app/host_collector.py
COPY clients/lucky_collector.py /app/lucky_collector.py
COPY clients/easytier_collector.py /app/easytier_collector.py
COPY clients/unifi_collector.py /app/unifi_collector.py
COPY clients/unifi_model_catalog.py /app/unifi_model_catalog.py
COPY clients/unifi_api.py /app/unifi_api.py
COPY clients/unifi_profile_loader.py /app/unifi_profile_loader.py
COPY clients/unifi_source_registry.py /app/unifi_source_registry.py
COPY clients/unifi_raw_collector.py /app/unifi_raw_collector.py
COPY clients/unifi_ssh_transport.py /app/unifi_ssh_transport.py
COPY clients/unifi_askpass.py /app/unifi_askpass.py
COPY clients/unifi_normalizer.py /app/unifi_normalizer.py
COPY clients/unifi_profiles /app/unifi_profiles
COPY clients/unifi_models /app/unifi_models
COPY scripts/export-hermes-status.py /app/export-hermes-status.py
COPY scripts/hermes_config_summary.py /app/hermes_config_summary.py
COPY hermes-exporter.json /app/hermes-exporter.json
COPY clients/entrypoint.sh /app/entrypoint.sh

# Collector defaults. Device v2 configuration remains file-backed.
ENV INTERVAL=1 \
    CLIENT=psutil \
    HOST_OS_RELEASE_FILE=/host/etc/os-release \
    DSM_VERSION_FILE=/host/etc.defaults/VERSION \
    HWMON_ROOT=/sys/class/hwmon \
    SMART_DEVICE=auto \
    DOCKER_SOCKET=/var/run/docker.sock \
    HARDWARE_INTERVAL=600 \
    DOCKER_INTERVAL=60 \
    DOCKER_CONTAINER_LIMIT=0 \
    CLIENT_STATUS_DIR=/var/lib/serverstatus-client \
    HERMES_EXPORT_CONFIG=/app/hermes-exporter.json \
    HERMES_ROOT=/home/hermes \
    HERMES_STATUS_DIR=/var/lib/serverstatus-client/hermes \
    HERMES_STATUS_FILE=/var/lib/serverstatus-client/hermes/hermes.json \
    HERMES_EXPORT_ENABLED=true \
    HERMES_EXPORT_INTERVAL=600 \
    HERMES_SNAPSHOT_INTERVAL=10 \
    LUCKY_ENABLED=false \
    LUCKY_BASE_URL=https://127.0.0.1:16601 \
    LUCKY_AUTH_MODE=none \
    LUCKY_TOKEN_FILE= \
    LUCKY_INTERVAL=600 \
    LUCKY_TIMEOUT_SECONDS=5 \
    LUCKY_VERSION_CHECK_TTL=21600 \
    LUCKY_VERIFY_TLS=true \
    LUCKY_CERT_WARNING_DAYS=30 \
    EASYTIER_ENABLED=false \
    EASYTIER_CLI_PATH=/usr/local/bin/easytier-cli \
    EASYTIER_RPC_PORTAL=127.0.0.1:15888 \
    EASYTIER_INTERVAL_SECONDS=30 \
    EASYTIER_TIMEOUT_SECONDS=5 \
    EASYTIER_ADMINISTRATIVE_ROLE= \
    HERMESSTATUS_CLIENT_VERSION=${VERSION} \
    HERMESSTATUS_CLIENT_REVISION=${VCS_REF} \
    HERMESSTATUS_CLIENT_BUILD_TIME=${BUILD_DATE}

RUN chmod +x /app/entrypoint.sh /app/unifi_askpass.py

ENTRYPOINT ["/app/entrypoint.sh"]
CMD []
