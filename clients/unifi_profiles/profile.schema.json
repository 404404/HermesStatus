{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HermesStatus UniFi collection profile V1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "platform",
    "generic",
    "diagnostics",
    "health_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "enum": [
        "udw",
        "ucg-max"
      ]
    },
    "platform": {
      "const": "unifi_console"
    },
    "generic": {
      "type": "object",
      "required": [
        "cpu_temperature",
        "cpu_usage",
        "memory",
        "uptime",
        "load_average"
      ],
      "additionalProperties": false,
      "properties": {
        "cpu_temperature": { "$ref": "#/$defs/source" },
        "cpu_usage": { "$ref": "#/$defs/source" },
        "memory": { "$ref": "#/$defs/source" },
        "uptime": { "$ref": "#/$defs/source" },
        "load_average": { "$ref": "#/$defs/source" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "health_policy": {
      "type": "object",
      "required": [
        "optional_diagnostics_affect_health",
        "zero_rpm_is_failure_when_present"
      ],
      "additionalProperties": false,
      "properties": {
        "optional_diagnostics_affect_health": { "const": false },
        "zero_rpm_is_failure_when_present": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "primary": { "type": "boolean" },
        "formula": { "type": "string", "minLength": 1 },
        "health_affecting": { "const": false },
        "zones": { "type": "object" },
        "expected_name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
