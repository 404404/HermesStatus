{
  "schema_version": 1,
  "profile_id": "ucg-max",
  "platform": "unifi_console",
  "generic": {
    "cpu_temperature": {
      "source": "unifi.cpu.temperature.ubnt_systool",
      "primary": true
    },
    "cpu_usage": {
      "source": "linux.proc.stat",
      "formula": "busy_without_idle_iowait"
    },
    "memory": {
      "source": "linux.proc.meminfo",
      "formula": "MemTotal-MemAvailable"
    },
    "uptime": {
      "source": "linux.proc.uptime"
    },
    "load_average": {
      "source": "linux.proc.loadavg"
    }
  },
  "diagnostics": {
    "thermal": {
      "source": "linux.sys.thermal",
      "health_affecting": false
    },
    "hwmon": {
      "source": "linux.sensors_json",
      "health_affecting": false,
      "expected_name": "lm63"
    }
  },
  "fans": {
    "channels": [
      {
        "id": "fan1",
        "supported": "unknown",
        "present": "unknown"
      }
    ]
  },
  "power": {
    "psu_slots": 0,
    "presence": "unknown",
    "sensor_mapping": "unknown",
    "max_power_w": null
  },
  "storage": {
    "nvme": {
      "supported": true,
      "present": "unknown",
      "observed": false,
      "capacity_bytes": null
    },
    "sata_ssd": {
      "supported": false,
      "present": "not_populated",
      "observed": false,
      "capacity_bytes": null
    },
    "tf": {
      "supported": false,
      "present": "not_populated",
      "observed": false,
      "capacity_bytes": null
    }
  },
  "health_policy": {
    "optional_diagnostics_affect_health": false,
    "zero_rpm_is_failure_when_present": false
  },
  "poe": {
    "supported": false,
    "total_max_power_w": null,
    "port_max_power_w": {}
  },
  "cpu_model": "Qualcomm IPQ5322"
}
