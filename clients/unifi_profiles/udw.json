{
  "schema_version": 1,
  "profile_id": "udw",
  "platform": "unifi_console",
  "generic": {
    "cpu_temperature": {
      "source": "unifi.cpu.temperature.ubnt_systool",
      "primary": true
    },
    "cpu_usage": {
      "source": "linux.proc.stat",
      "formula": "busy_without_idle_iowait"
    },
    "memory": {
      "source": "linux.proc.meminfo",
      "formula": "MemTotal-MemAvailable"
    },
    "uptime": {
      "source": "linux.proc.uptime"
    },
    "load_average": {
      "source": "linux.proc.loadavg"
    }
  },
  "diagnostics": {
    "thermal": {
      "source": "linux.sys.thermal",
      "health_affecting": false
    },
    "hwmon": {
      "source": "linux.sys.hwmon",
      "health_affecting": false
    },
    "hardware_cache": {
      "source": "unifi.udw.ustd_hw_polling",
      "health_affecting": false
    },
    "filesystem": {
      "source": "unifi.udw.ssd_filesystem",
      "health_affecting": false
    }
  },
  "fans": {
    "channels": [
      {
        "id": "fan1",
        "supported": true,
        "present": "present"
      },
      {
        "id": "fan2",
        "supported": true,
        "present": "present"
      },
      {
        "id": "fan3",
        "supported": true,
        "present": "not_populated"
      },
      {
        "id": "fan4",
        "supported": true,
        "present": "not_populated"
      }
    ]
  },
  "power": {
    "psu_slots": 2,
    "presence": "dynamic",
    "sensor_mapping": "unknown",
    "max_power_w": 550
  },
  "storage": {
    "nvme": {
      "supported": false,
      "present": "not_populated",
      "observed": false,
      "capacity_bytes": null
    },
    "sata_ssd": {
      "supported": true,
      "present": "present",
      "observed": "unknown",
      "capacity_bytes": 128000000000
    },
    "tf": {
      "supported": true,
      "present": "not_populated",
      "observed": "unknown",
      "capacity_bytes": null
    }
  },
  "health_policy": {
    "optional_diagnostics_affect_health": false,
    "zero_rpm_is_failure_when_present": false
  },
  "cpu_model": "Annapurna AL324",
  "poe": {
    "supported": true,
    "total_max_power_w": 420,
    "port_max_power_w": {
      "1": 15.4,
      "2": 15.4,
      "3": 15.4,
      "4": 15.4,
      "5": 30,
      "6": 30,
      "7": 30,
      "8": 30,
      "9": 60,
      "10": 60,
      "11": 60,
      "12": 60
    }
  }
}
