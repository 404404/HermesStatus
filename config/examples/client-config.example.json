    "hardware": {"enabled": true},
    "filesystem": {"enabled": true, "probes": []},
    "smart": {"enabled": false},
    "docker": {"enabled": true},
    "hermes": {"enabled": true},
    "lucky": {"enabled": false},
    "easytier": {"enabled": false},
    "unifi": {"enabled": false}
  }
}