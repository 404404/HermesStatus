{
  "schema_version": 1,
  "server": {
    "url": "https://status.example.invalid:21443",
    "verify_tls": true,
    "connect_timeout_seconds": 10,
    "read_timeout_seconds": 30,
    "ca_file": "/run/secrets/preview-ca.crt"
  },
  "device": {
