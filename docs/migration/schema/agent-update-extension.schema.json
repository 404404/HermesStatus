{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/404404/HermesStatus/schemas/agent-update-extension.schema.json",
  "title": "HermesStatus agent update extension",
  "description": "Only the HermesStatus extension merged into a native ServerStatus agent update. Native AgentStats fields are intentionally omitted.",
  "$comment": "additionalProperties is false at every contract object boundary so unknown upstream fields and secret-bearing configuration cannot be passed through by accident.",
  "type": "object",
  "required": [
    "extension_version",
    "hardware",
    "docker",
    "hermes",
    "lucky"
  ],
  "properties": {
    "extension_version": {
      "const": "1.0-draft",
      "maxLength": 32
    },
    "hardware": {
      "$ref": "#/$defs/hardware"
    },
    "docker": {
      "$ref": "#/$defs/docker"
    },
    "hermes": {
      "$ref": "#/$defs/hermes"
    },
    "lucky": {
      "$ref": "lucky-extension.schema.json"
    },
    "easytier": {
      "$ref": "easytier-extension.schema.json"
    },
    "client_build": {
      "$ref": "#/$defs/clientBuild"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nullableDateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "maxLength": 40
    },
    "nullableCounter": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message",
        "source",
        "retryable",
        "http_status"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        }
      },
      "additionalProperties": false
    },
    "cpuTemperature": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "value",
        "unit",
        "source"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": -100,
          "maximum": 250
        },
        "unit": {
          "const": "C"
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "diskTemperature": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "current",
        "highest",
        "lowest",
        "unit",
        "source"
      ],
      "properties": {
        "current": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -100,
          "maximum": 250
        },
        "highest": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -100,
          "maximum": 250
        },
        "lowest": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -100,
          "maximum": 250
        },
        "unit": {
          "const": "C"
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "physicalDisk": {
      "type": "object",
      "required": [
        "id", "device", "model", "capacity_bytes", "temperature_c",
        "smart_status", "power_on_hours", "written_bytes", "read_bytes",
        "smart_source", "collection_status"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]*$"},
        "device": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^/dev/[A-Za-z0-9._+/-]+$"},
        "model": {"type": ["string", "null"], "maxLength": 256},
        "capacity_bytes": {"$ref": "#/$defs/nullableCounter"},
        "temperature_c": {"type": ["number", "null"], "minimum": -100, "maximum": 250},
        "smart_status": {"enum": ["passed", "failed", "unknown"]},
        "power_on_hours": {"$ref": "#/$defs/nullableCounter"},
        "written_bytes": {"$ref": "#/$defs/nullableCounter"},
        "read_bytes": {"$ref": "#/$defs/nullableCounter"},
        "smart_source": {"type": ["string", "null"], "maxLength": 64},
        "completeness": {"type": ["string", "null"], "enum": ["complete", "partial", "unavailable", null]},
        "health_source": {"type": ["string", "null"], "enum": ["native_status", "attribute_check", "unknown", null]},
        "native_status": {"type": ["string", "null"], "enum": ["available", "unavailable", "unknown", null]},
        "collection_status": {"enum": ["healthy", "partial", "unavailable", "unsupported", "permission_denied", "invalid_data"]},
        "error": {"$ref": "#/$defs/error"}
      },
      "additionalProperties": false
    },
    "filesystem": {
      "type": "object",
      "required": [
        "source", "mountpoint", "fs_type", "total_bytes", "used_bytes",
        "available_bytes", "usage_percent", "backing_disk_ids", "stack_type",
        "collection_status"
      ],
      "properties": {
        "source": {"type": ["string", "null"], "maxLength": 256},
        "mountpoint": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^/.*$", "description": "Absolute display path; control characters and parent traversal are rejected by the strict server contract"},
        "fs_type": {"type": ["string", "null"], "maxLength": 64},
        "total_bytes": {"$ref": "#/$defs/nullableCounter"},
        "used_bytes": {"$ref": "#/$defs/nullableCounter"},
        "available_bytes": {"$ref": "#/$defs/nullableCounter"},
        "usage_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "backing_disk_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}},
        "stack_type": {"enum": ["plain", "lvm", "mdraid", "device_mapper", "btrfs", "unknown"]},
        "collection_status": {"enum": ["healthy", "unavailable", "unsupported", "permission_denied", "invalid_data"]},
        "error": {"$ref": "#/$defs/error"}
      },
      "additionalProperties": false
    },
    "storageSummary": {
      "type": "object",
      "required": ["physical_disk_count", "smart_passed", "smart_failed", "smart_unknown", "temperature_min_c", "temperature_max_c", "filesystem_count"],
      "properties": {
        "physical_disk_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "smart_passed": {"type": "integer", "minimum": 0, "maximum": 64},
        "smart_failed": {"type": "integer", "minimum": 0, "maximum": 64},
        "smart_unknown": {"type": "integer", "minimum": 0, "maximum": 64},
        "temperature_min_c": {"type": ["number", "null"], "minimum": -100, "maximum": 250},
        "temperature_max_c": {"type": ["number", "null"], "minimum": -100, "maximum": 250},
        "filesystem_count": {"type": "integer", "minimum": 0, "maximum": 128}
      },
      "additionalProperties": false
    },
    "storage": {
      "type": ["object", "null"],
      "required": ["physical_disks", "filesystems", "summary", "updated_at", "stale", "error"],
      "properties": {
        "physical_disks": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/physicalDisk"}},
        "filesystems": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/filesystem"}},
        "summary": {"$ref": "#/$defs/storageSummary"},
        "updated_at": {"$ref": "#/$defs/nullableDateTime"},
        "stale": {"type": "boolean"},
        "error": {"$ref": "#/$defs/error"}
      },
      "additionalProperties": false
    },
    "systemIdentity": {
      "type": ["object", "null"],
      "required": ["distribution", "release_version", "pretty_name", "kernel_release", "architecture", "source"],
      "properties": {
        "distribution": {"type": ["string", "null"], "maxLength": 256},
        "release_version": {"type": ["string", "null"], "maxLength": 256},
        "pretty_name": {"type": ["string", "null"], "maxLength": 256},
        "kernel_release": {"type": ["string", "null"], "maxLength": 256},
        "architecture": {"type": ["string", "null"], "maxLength": 256},
        "source": {"enum": ["os-release", "dsm-version", "unavailable", "unknown"]}
      },
      "additionalProperties": false
    },
    "cpuUsage": {
      "type": ["object", "null"],
      "required": ["user_percent", "nice_percent", "system_percent", "idle_percent", "iowait_percent", "irq_percent", "softirq_percent", "steal_percent", "total_percent"],
      "properties": {
        "user_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "nice_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "system_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "idle_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "iowait_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "irq_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "softirq_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "steal_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "total_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "cpuDetails": {
      "type": ["object", "null"],
      "required": ["architecture", "vendor", "family", "model_id", "model_name", "stepping", "virtualization", "l1d_cache", "l1i_cache", "l2_cache", "l3_cache", "logical_cpus", "sockets", "cores_per_socket", "threads_per_core", "max_mhz", "min_mhz", "current_mhz", "usage"],
      "properties": {
        "architecture": {"type": ["string", "null"], "maxLength": 128}, "vendor": {"type": ["string", "null"], "maxLength": 128}, "family": {"type": ["string", "null"], "maxLength": 128}, "model_id": {"type": ["string", "null"], "maxLength": 128}, "model_name": {"type": ["string", "null"], "maxLength": 128}, "stepping": {"type": ["string", "null"], "maxLength": 128}, "virtualization": {"type": ["string", "null"], "maxLength": 128},
        "l1d_cache": {"type": ["string", "null"], "maxLength": 128}, "l1i_cache": {"type": ["string", "null"], "maxLength": 128}, "l2_cache": {"type": ["string", "null"], "maxLength": 128}, "l3_cache": {"type": ["string", "null"], "maxLength": 128},
        "logical_cpus": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536}, "sockets": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536}, "cores_per_socket": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536}, "threads_per_core": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536},
        "max_mhz": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000}, "min_mhz": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000}, "current_mhz": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000}, "usage": {"$ref": "#/$defs/cpuUsage"}
      },
      "additionalProperties": false
    },
    "memoryDetails": {
      "type": ["object", "null"],
      "required": ["total_bytes", "used_bytes", "available_bytes", "free_bytes", "buffers_bytes", "cached_bytes", "reclaimable_bytes", "active_bytes", "inactive_bytes", "dirty_bytes", "writeback_bytes", "slab_bytes", "swap_total_bytes", "swap_used_bytes", "swap_free_bytes", "swap_cached_bytes"],
      "properties": {
        "total_bytes": {"$ref": "#/$defs/nullableCounter"}, "used_bytes": {"$ref": "#/$defs/nullableCounter"}, "available_bytes": {"$ref": "#/$defs/nullableCounter"}, "free_bytes": {"$ref": "#/$defs/nullableCounter"}, "buffers_bytes": {"$ref": "#/$defs/nullableCounter"}, "cached_bytes": {"$ref": "#/$defs/nullableCounter"}, "reclaimable_bytes": {"$ref": "#/$defs/nullableCounter"}, "active_bytes": {"$ref": "#/$defs/nullableCounter"}, "inactive_bytes": {"$ref": "#/$defs/nullableCounter"}, "dirty_bytes": {"$ref": "#/$defs/nullableCounter"}, "writeback_bytes": {"$ref": "#/$defs/nullableCounter"}, "slab_bytes": {"$ref": "#/$defs/nullableCounter"}, "swap_total_bytes": {"$ref": "#/$defs/nullableCounter"}, "swap_used_bytes": {"$ref": "#/$defs/nullableCounter"}, "swap_free_bytes": {"$ref": "#/$defs/nullableCounter"}, "swap_cached_bytes": {"$ref": "#/$defs/nullableCounter"}
      },
      "additionalProperties": false
    },
    "clientBuild": {
      "type": ["object", "null"],
      "required": ["version", "revision", "build_time", "protocol"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "build_time": {"$ref": "#/$defs/nullableDateTime"},
        "protocol": {"const": "device_v2"}
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "required": [
        "cpu_model",
        "cpu_temperature",
        "disk_temperature",
        "disk_smart_status",
        "disk_power_on_hours",
        "disk_written_bytes",
        "disk_read_bytes",
        "disk_device",
        "disk_smart_source",
        "updated_at",
        "stale",
        "error"
      ],
      "properties": {
        "cpu_model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "cpu_details": {"$ref": "#/$defs/cpuDetails"},
        "memory_details": {"$ref": "#/$defs/memoryDetails"},
        "cpu_temperature": {
          "$ref": "#/$defs/cpuTemperature"
        },
        "disk_temperature": {
          "$ref": "#/$defs/diskTemperature"
        },
        "disk_smart_status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "disk_power_on_hours": {
          "$ref": "#/$defs/nullableCounter"
        },
        "disk_written_bytes": {
          "$ref": "#/$defs/nullableCounter"
        },
        "disk_read_bytes": {
          "$ref": "#/$defs/nullableCounter"
        },
        "disk_device": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "disk_smart_source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "system_identity": {
          "$ref": "#/$defs/systemIdentity"
        },
        "updated_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "stale": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "additionalProperties": false
    },
    "dockerContainer": {
      "type": "object",
      "required": [
        "names",
        "image",
        "status",
        "ports"
      ],
      "properties": {
        "names": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ports": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    },
    "docker": {
      "type": "object",
      "required": [
        "running",
        "total",
        "limit",
        "truncated",
        "containers",
        "updated_at",
        "stale",
        "error"
      ],
      "properties": {
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "truncated": {
          "type": "boolean"
        },
        "containers": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/dockerContainer"
          }
        },
        "updated_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "stale": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "additionalProperties": false
    },
    "tokenUsage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "estimated",
        "source",
        "window_start",
        "window_end"
      ],
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/nullableCounter"
        },
        "output_tokens": {
          "$ref": "#/$defs/nullableCounter"
        },
        "total_tokens": {
          "$ref": "#/$defs/nullableCounter"
        },
        "estimated": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "hermes_api_payload",
            "local_session_state",
            "local_logs",
            "unavailable"
          ]
        },
        "window_start": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "window_end": {
          "$ref": "#/$defs/nullableDateTime"
        }
      },
      "additionalProperties": false
    },
    "configModelSummary": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "base_url",
        "concurrency",
        "timeout_seconds"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "maxLength": 256
        },
        "base_url": {
          "type": "string",
          "maxLength": 256
        },
        "concurrency": {
          "$ref": "#/$defs/nullableCounter"
        },
        "timeout_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "auxiliaryModelSummary": {
      "type": "object",
      "required": [
        "name",
        "provider",
        "model",
        "effective_provider",
        "effective_model",
        "source",
        "base_url_display",
        "timeout_seconds",
        "download_timeout_seconds",
        "max_concurrency",
        "language",
        "extra_body_configured",
        "credential_configured"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "provider": {
          "type": "string",
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "maxLength": 256
        },
        "effective_provider": {
          "type": "string",
          "maxLength": 128
        },
        "effective_model": {
          "type": "string",
          "maxLength": 256
        },
        "source": {
          "type": "string",
          "enum": [
            "config",
            "main_model"
          ]
        },
        "base_url_display": {
          "type": "string",
          "maxLength": 256
        },
        "timeout_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 86400
        },
        "download_timeout_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 86400
        },
        "max_concurrency": {
          "$ref": "#/$defs/nullableCounter"
        },
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "extra_body_configured": {
          "type": "boolean"
        },
        "credential_configured": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "delegationSummary": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "base_url",
        "reasoning_effort",
        "max_concurrent_children",
        "max_spawn_depth",
        "child_timeout_seconds"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "maxLength": 256
        },
        "base_url": {
          "type": "string",
          "maxLength": 256
        },
        "reasoning_effort": {
          "type": "string",
          "maxLength": 64
        },
        "max_concurrent_children": {
          "$ref": "#/$defs/nullableCounter"
        },
        "max_spawn_depth": {
          "$ref": "#/$defs/nullableCounter"
        },
        "child_timeout_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "configSummary": {
      "type": [
        "object",
        "null"
      ],
      "description": "Sanitized Release B projection. Legacy objects containing only docker_volumes remain accepted during migration.",
      "required": [
        "docker_volumes"
      ],
      "properties": {
        "config_found": {
          "type": "boolean"
        },
        "main_model": {
          "$ref": "#/$defs/configModelSummary"
        },
        "auxiliary_models": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/auxiliaryModelSummary"
          }
        },
        "delegation": {
          "$ref": "#/$defs/delegationSummary"
        },
        "docker_volumes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "additionalProperties": false
    },
    "mixtureOfAgents": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source",
        "available",
        "name",
        "label",
        "description",
        "enabled",
        "configured",
        "tools",
        "error"
      ],
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 64
        },
        "available": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "configured": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "hermesProfile": {
      "type": "object",
      "required": [
        "profile",
        "agent_version",
        "api_status",
        "service_status",
