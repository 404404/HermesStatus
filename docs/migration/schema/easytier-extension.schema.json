{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/404404/HermesStatus/schemas/easytier-extension.schema.json",
  "title": "HermesStatus EasyTier monitoring extension",
  "$comment": "Strict read-only monitoring projection. Configuration, RPC portals, credentials, raw command output and stderr are deliberately absent. Bounded connector and listener endpoints are retained only after credential/query stripping.",
  "type": "object",
  "required": ["status", "source", "node", "peers", "routes", "connectors", "traffic", "command_status", "updated_at", "stale", "error"],
  "properties": {
    "status": {"enum": ["healthy", "degraded", "unavailable", "stale", "not_configured", "unsupported_version", "invalid_data"]},
    "source": {"enum": ["easytier_cli", "unavailable"]},
    "node": {"$ref": "#/$defs/node"},
    "peers": {"$ref": "#/$defs/peers"},
    "routes": {"$ref": "#/$defs/routes"},
    "connectors": {"$ref": "#/$defs/connectors"},
    "traffic": {"$ref": "#/$defs/traffic"},
    "command_status": {"$ref": "#/$defs/commandStatus"},
    "updated_at": {"$ref": "#/$defs/nullableDateTime"},
    "stale": {"type": "boolean"},
    "error": {"$ref": "agent-update-extension.schema.json#/$defs/error"}
  },
  "additionalProperties": false,
  "$defs": {
    "nullableDateTime": {"type": ["string", "null"], "format": "date-time", "maxLength": 40},
    "nullableText": {"type": ["string", "null"], "maxLength": 128},
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "node": {
      "type": "object",
      "required": ["state", "instance_name", "network_name", "version", "peer_id"],
      "properties": {"state": {"type": "string", "minLength": 1, "maxLength": 128}, "instance_name": {"$ref": "#/$defs/nullableText"}, "network_name": {"$ref": "#/$defs/nullableText"}, "version": {"$ref": "#/$defs/nullableText"}, "peer_id": {"$ref": "#/$defs/nullableText"}, "overlay_ipv4": {"$ref": "#/$defs/nullableText"}, "proxy_cidrs": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}}, "administrative_role": {"type": ["string", "null"], "enum": ["site_router", "endpoint", "bootstrap_listener", "relay_capable", "observer", null]}, "hostname": {"$ref": "#/$defs/nullableText"}, "inst_id": {"$ref": "#/$defs/nullableText"}, "listeners": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 128}}, "stun_info": {"$ref": "#/$defs/stunInfo"}, "schema_compatibility": {"enum": ["supported", "unsupported", "unknown"]}},
      "additionalProperties": false
    },
    "peers": {
      "type": "object",
      "required": ["total", "direct", "relay", "unknown_path"],
      "properties": {"total": {"type": "integer", "minimum": 0, "maximum": 256}, "direct": {"type": "integer", "minimum": 0, "maximum": 256}, "relay": {"type": "integer", "minimum": 0, "maximum": 256}, "unknown_path": {"type": "integer", "minimum": 0, "maximum": 256}, "ipv6_udp_direct": {"type": ["boolean", "null"]}, "items": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/peer"}}},
      "additionalProperties": false
    },
    "routes": {"type": "object", "required": ["total"], "properties": {"total": {"type": "integer", "minimum": 0, "maximum": 256}, "items": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/route"}}}, "additionalProperties": false},
    "connectors": {"type": "object", "required": ["total", "tcp_configured", "tcp_active"], "properties": {"total": {"type": "integer", "minimum": 0, "maximum": 256}, "tcp_configured": {"type": "boolean"}, "tcp_active": {"type": "boolean"}, "tcp_listener_available": {"type": ["boolean", "null"]}, "items": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/connector"}}}, "additionalProperties": false},
    "traffic": {"type": "object", "required": ["bytes_rx", "bytes_tx", "bytes_forwarded"], "properties": {"bytes_rx": {"$ref": "#/$defs/counter"}, "bytes_tx": {"$ref": "#/$defs/counter"}, "bytes_forwarded": {"$ref": "#/$defs/counter"}, "packets_rx": {"$ref": "#/$defs/counter"}, "packets_tx": {"$ref": "#/$defs/counter"}, "rx_bps": {"type": ["number", "null"], "minimum": 0}, "tx_bps": {"type": ["number", "null"], "minimum": 0}, "by_instance": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/instanceTraffic"}}, "samples": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/metricSample"}}}, "additionalProperties": false},
    "command": {"type": "object", "required": ["status", "error"], "properties": {"status": {"enum": ["healthy", "degraded", "unavailable", "stale", "not_configured", "unsupported_version", "invalid_data"]}, "last_success_at": {"$ref": "#/$defs/nullableDateTime"}, "collected_at": {"$ref": "#/$defs/nullableDateTime"}, "duration_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 30000}, "error": {"$ref": "agent-update-extension.schema.json#/$defs/error"}}, "additionalProperties": false},
    "peer": {"type": "object", "required": ["peer_id", "overlay_ipv4", "hostname", "version", "path_state", "transport", "address_family", "locally_initiated", "latency_ms", "loss_rate", "rx_bytes", "tx_bytes", "rx_packets", "tx_packets", "closed"], "properties": {"peer_id": {"$ref": "#/$defs/nullableText"}, "overlay_ipv4": {"$ref": "#/$defs/nullableText"}, "hostname": {"$ref": "#/$defs/nullableText"}, "version": {"$ref": "#/$defs/nullableText"}, "path_state": {"enum": ["direct", "relayed", "unknown"]}, "transport": {"enum": ["udp", "tcp", "quic", "wg", "wss", "unknown"]}, "address_family": {"enum": ["ipv4", "ipv6", "unknown"]}, "locally_initiated": {"type": "boolean"}, "latency_ms": {"type": ["number", "null"], "minimum": 0, "maximum": 600000}, "loss_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "rx_bytes": {"$ref": "#/$defs/counter"}, "tx_bytes": {"$ref": "#/$defs/counter"}, "rx_packets": {"$ref": "#/$defs/counter"}, "tx_packets": {"$ref": "#/$defs/counter"}, "closed": {"type": "boolean"}, "cost": {"$ref": "#/$defs/nullableText"}, "established_tunnels": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 16}}, "nat_type": {"$ref": "#/$defs/nullableText"}, "rx_display": {"$ref": "#/$defs/nullableText"}, "tx_display": {"$ref": "#/$defs/nullableText"}}, "additionalProperties": false},
    "route": {"type": "object", "required": ["peer_id", "overlay_ipv4", "hostname", "version", "next_hop_peer_id", "cost", "path_latency_ms", "proxy_cidrs", "path_state", "is_local"], "properties": {"peer_id": {"$ref": "#/$defs/nullableText"}, "overlay_ipv4": {"$ref": "#/$defs/nullableText"}, "hostname": {"$ref": "#/$defs/nullableText"}, "version": {"$ref": "#/$defs/nullableText"}, "next_hop_peer_id": {"$ref": "#/$defs/nullableText"}, "cost": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000}, "path_latency_ms": {"type": ["number", "null"], "minimum": 0, "maximum": 600000}, "proxy_cidrs": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}}, "path_state": {"enum": ["direct", "relayed", "unknown"]}, "is_local": {"type": "boolean"}}, "additionalProperties": false},
    "connector": {"type": "object", "required": ["transport", "address_family", "port", "status"], "properties": {"url": {"$ref": "#/$defs/nullableText"}, "endpoint": {"$ref": "#/$defs/nullableText"}, "transport": {"enum": ["udp", "tcp", "quic", "wg", "wss", "unknown"]}, "address_family": {"enum": ["ipv4", "ipv6", "unknown"]}, "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535}, "raw_status": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647}, "status": {"enum": ["connected", "connecting", "disconnected", "unknown"]}}, "additionalProperties": false},
    "stunInfo": {"type": "object", "properties": {"udp_nat_type": {"$ref": "#/$defs/nullableText"}, "tcp_nat_type": {"$ref": "#/$defs/nullableText"}, "public_ips": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}}, "last_update_time": {"$ref": "#/$defs/nullableText"}}, "additionalProperties": false},
    "instanceTraffic": {"type": "object", "properties": {"network_name": {"$ref": "#/$defs/nullableText"}, "from_instance_id": {"$ref": "#/$defs/nullableText"}, "to_instance_id": {"$ref": "#/$defs/nullableText"}, "bytes_rx": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}, "bytes_tx": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}, "packets_rx": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}, "packets_tx": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}}, "additionalProperties": false},
    "metricSample": {"type": "object", "required": ["name", "value", "labels"], "properties": {"name": {"type": "string", "maxLength": 64}, "value": {"$ref": "#/$defs/counter"}, "labels": {"type": "object", "maxProperties": 8, "additionalProperties": {"type": "string", "maxLength": 128}}}, "additionalProperties": false},
    "commandStatus": {"type": "object", "required": ["node_info", "peer_list", "route_list", "connector_list", "stats_show"], "properties": {"node_info": {"$ref": "#/$defs/command"}, "peer_list": {"$ref": "#/$defs/command"}, "route_list": {"$ref": "#/$defs/command"}, "connector_list": {"$ref": "#/$defs/command"}, "stats_show": {"$ref": "#/$defs/command"}}, "additionalProperties": false}
  }
}
