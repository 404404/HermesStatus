{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/404404/HermesStatus/schemas/easytier-extension.schema.json",
  "title": "HermesStatus EasyTier monitoring extension",
  "$comment": "Strict read-only monitoring projection. Configuration, RPC portals, endpoints, credentials, raw command output and stderr are deliberately absent.",
  "type": "object",
  "required": ["status", "source", "node", "peers", "routes", "connectors", "traffic", "command_status", "updated_at", "stale", "error"],
  "properties": {
    "status": {"enum": ["healthy", "degraded", "unavailable", "stale", "not_configured", "unsupported_version", "invalid_data"]},
    "source": {"enum": ["easytier_cli", "unavailable"]},
    "node": {"$ref": "#/$defs/node"},
    "peers": {"$ref": "#/$defs/peers"},
    "routes": {"$ref": "#/$defs/routes"},
    "connectors": {"$ref": "#/$defs/connectors"},
    "traffic": {"$ref": "#/$defs/traffic"},
    "command_status": {"$ref": "#/$defs/commandStatus"},
    "updated_at": {"$ref": "#/$defs/nullableDateTime"},
    "stale": {"type": "boolean"},
    "error": {"$ref": "agent-update-extension.schema.json#/$defs/error"}
  },
  "additionalProperties": false,
  "$defs": {
    "nullableDateTime": {"type": ["string", "null"], "format": "date-time", "maxLength": 40},
    "nullableText": {"type": ["string", "null"], "maxLength": 128},
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "node": {
      "type": "object",
      "required": ["state", "instance_name", "network_name", "version", "peer_id"],
      "properties": {"state": {"type": "string", "minLength": 1, "maxLength": 128}, "instance_name": {"$ref": "#/$defs/nullableText"}, "network_name": {"$ref": "#/$defs/nullableText"}, "version": {"$ref": "#/$defs/nullableText"}, "peer_id": {"$ref": "#/$defs/nullableText"}},
      "additionalProperties": false
    },
    "peers": {
      "type": "object",
      "required": ["total", "direct", "relay", "unknown_path"],
      "properties": {"total": {"type": "integer", "minimum": 0, "maximum": 256}, "direct": {"type": "integer", "minimum": 0, "maximum": 256}, "relay": {"type": "integer", "minimum": 0, "maximum": 256}, "unknown_path": {"type": "integer", "minimum": 0, "maximum": 256}},
      "additionalProperties": false
    },
    "routes": {"type": "object", "required": ["total"], "properties": {"total": {"type": "integer", "minimum": 0, "maximum": 256}}, "additionalProperties": false},
    "connectors": {"type": "object", "required": ["total", "tcp_configured", "tcp_active"], "properties": {"total": {"type": "integer", "minimum": 0, "maximum": 256}, "tcp_configured": {"type": "boolean"}, "tcp_active": {"type": "boolean"}}, "additionalProperties": false},
    "traffic": {"type": "object", "required": ["bytes_rx", "bytes_tx", "bytes_forwarded"], "properties": {"bytes_rx": {"$ref": "#/$defs/counter"}, "bytes_tx": {"$ref": "#/$defs/counter"}, "bytes_forwarded": {"$ref": "#/$defs/counter"}}, "additionalProperties": false},
    "command": {"type": "object", "required": ["status", "error"], "properties": {"status": {"enum": ["healthy", "degraded", "unavailable", "stale", "not_configured", "unsupported_version", "invalid_data"]}, "error": {"$ref": "agent-update-extension.schema.json#/$defs/error"}}, "additionalProperties": false},
    "commandStatus": {"type": "object", "required": ["node_info", "peer_list", "route_list", "connector_list", "stats_show"], "properties": {"node_info": {"$ref": "#/$defs/command"}, "peer_list": {"$ref": "#/$defs/command"}, "route_list": {"$ref": "#/$defs/command"}, "connector_list": {"$ref": "#/$defs/command"}, "stats_show": {"$ref": "#/$defs/command"}}, "additionalProperties": false}
  }
}
