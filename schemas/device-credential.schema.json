{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/hermesstatus/device-credential.schema.json",
  "title": "HermesStatus 2.2 server-side device credential record",
  "type": "object",
  "required": ["version", "device_id", "algorithm", "credentials"],
  "properties": {
    "version": {"const": 1},
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "algorithm": {"const": "sha256"},
    "credentials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "digest", "not_before", "not_after"],
        "properties": {
          "id": {"enum": ["current", "next"]},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "not_before": {"type": "string", "format": "date-time", "maxLength": 40},
          "not_after": {"type": "string", "format": "date-time", "maxLength": 40}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$comment": "Credential-slot uniqueness and not_after>not_before are enforced by the Stage A pure validator. SHA-256 is permitted only for random high-entropy non-memorable tokens, never human passwords."
}
