{
  "version": 1,
  "server": {
    "url": "https://status.example.invalid",
    "verify_tls": true,
    "ca_file": null,
    "connect_timeout_seconds": 10,
    "read_timeout_seconds": 30
  },
  "device": {
    "id": "device-alpha",
    "name": "Synthetic Alpha",
    "fqdn": "alpha.example.invalid",
    "token_file": "/run/secrets/synthetic-device-token"
  },
  "collection": {
    "interval_seconds": 60
  },
  "hardware": {
    "smart_devices": [
      {"path": "/dev/disk+1", "type": null, "label": "synthetic-disk"}
    ],
    "primary_smart_device": "/dev/disk+1",
    "filesystem_probes": [
      {"mountpoint": "/data", "probe_path": "/host-storage/data"}
    ]
  }
}
